#!/bin/bash
# Renderer: sound-tts
# Text-to-speech via iTerm2 escape sequence. Only speaks on agent state change.

rlog() { log "${RENDER_PID:--}" "    sound-tts: $1"; }
# Same as rlog, but also streams to stderr - so `! notify update ...` run
# manually shows it immediately, not just in the log file.
rerr() { rlog "$1"; echo "notify: sound-tts: $1" >&2; }

# Sets TTS_NAME (what would be spoken) and TTS_NAME_REASON (which branch
# picked it, for logging). Priority order:
#   1. "name" key in sound-tts settings (session override, then global)
#   2. adapter-provided session name
#   3. tmux pane title (ignored if it's still tmux's un-set default, which
#      is just the machine hostname - not a meaningful name)
#   4. working directory basename
#   5. fallback default "claude"
resolve_tts_name() {
  local name

  name=$(echo "$RENDERER_SETTINGS" | jq -r '."sound-tts".name // empty')
  if [ -n "$name" ]; then
    TTS_NAME="$name"
    TTS_NAME_REASON="name set in sound-tts settings"
    return
  fi

  if [ -n "$SESSION_NAME" ]; then
    TTS_NAME="$SESSION_NAME"
    TTS_NAME_REASON="agent adapter session name"
    return
  fi

  if [ -n "$SESSION_TMUX_PANE" ]; then
    name=$(tmux display-message -t "$SESSION_TMUX_PANE" -p '#{pane_title}' 2>/dev/null)
    if [ -n "$name" ] && [ "$name" != "$(hostname)" ]; then
      TTS_NAME="$name"
      TTS_NAME_REASON="tmux pane title"
      return
    fi
  fi

  if [ -n "$AGENT_WD" ] && [ "$AGENT_WD" != "$HOME" ] && [ "$AGENT_WD" != "/" ]; then
    TTS_NAME=$(basename "$AGENT_WD")
    TTS_NAME_REASON="working directory name"
    return
  fi

  TTS_NAME="agent"
  TTS_NAME_REASON="fallback default"
}

speak() {
  local volume="$1"
  resolve_tts_name
  rerr "speak tts_name=$TTS_NAME volume=$volume reason=$TTS_NAME_REASON tty=$CLIENT_TTY"
  printf '\033Ptmux;\033\033]1337;Custom=id=tts:[[volm %s]] %s\a\033\\' "$volume" "$TTS_NAME" > "$CLIENT_TTY" 2>/dev/null
}

case "$TRIGGER" in
  AGENT_STATE_UPDATE)
    [ -z "$AGENT_STATE" ] && { rerr "skip (no agent state)"; exit 0; }
    [ -n "$CLIENT_TTY" ] && [ -e "$CLIENT_TTY" ] || { rerr "skip (no client tty) - cannot speak"; exit 0; }

    volume=$(echo "$RENDERER_SETTINGS" | jq -r ".\"sound-tts\".\"$AGENT_STATE\" // 0")
    awk -v v="$volume" 'BEGIN { exit !(v > 0) }' || { rerr "skip (volume 0 for state $AGENT_STATE)"; exit 0; }

    # WaitingForUser is debounced: some agents (Codex's PermissionRequest,
    # under an auto-approval policy) fire it even when nothing ever actually
    # waits on a human, and there's no hook-payload signal to tell the two
    # cases apart (see HISTORY.md). Wait a beat and re-check disk state right
    # before speaking, so a fast auto-approval never speaks at all.
    # (debounce only looked up for WaitingForUser - no point paying for a jq
    # call on every other state transition, which is the common case.)
    debounce=0
    [ "$AGENT_STATE" = "WaitingForUser" ] && debounce=$(echo "$RENDERER_SETTINGS" | jq -r '."sound-tts".waiting_debounce_secs // 0')
    if awk -v v="$debounce" 'BEGIN { exit !(v > 0) }'; then
      rlog "debounce ${debounce}s before speaking"
      # Detached from the hook's stdio: a hook runner that waits for pipe EOF
      # (Codex does) would otherwise block for the whole sleep, blow its 2s
      # deadline ("Hook failed") and kill this job before it ever alerts.
      ( sleep "$debounce"
        [ "$(current_agent_state "$RENDER_PID")" = "WaitingForUser" ] || { rlog "debounce cancelled (state moved on)"; exit 0; }
        speak "$volume"
      ) </dev/null >/dev/null 2>&1 &
    else
      speak "$volume"
    fi
    ;;
  USER_STATE_UPDATE|REFRESH) rlog "skip trigger=$TRIGGER" ;;
  STATUS)
    resolve_tts_name
    printf "TTS_NAME: '%s'\n" "$TTS_NAME"
    printf "TTS_NAME_REASON: '%s'\n" "$TTS_NAME_REASON"
    ;;
esac
