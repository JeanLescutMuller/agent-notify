#!/bin/bash
# Renderer: iterm-status
# The iTerm2 tab of a tmux client: a colored dot and a subtitle (OSC 21337
# "tab status") summing up every notify-managed pane of the tmux session, and
# the tab title (the tmux session name, OSC 0), written to the client's tty.
#
# Why: outside tmux, Claude Code sends iTerm2 OSC 7501 itself (3 fixed dots:
# idle green, working orange, blocked blue). Inside tmux it never does: its
# probe (OSC 7501 ; ?) gets no answer through tmux (Claude Code 2.1.325, tmux
# 3.7c, 2026-11-16). OSC 21337 takes any dot color and a subtitle text, so the
# dot can also show what Claude cannot: done-but-unseen vs seen, on hold.
#
# Each pane maps to a category through settings ("<state>.<user state>", then
# "<state>"); no mapping (Seen, Acknowledged by default) = the pane does not
# count. The dot takes the color of the first category in "priority" that has
# a pane; the subtitle counts every category, e.g. "2 waiting · 1 working".
# v5.16-v5.17 sent OSC 7501 records instead: each render still clears them.

rlog() { log "${RENDER_PID:--}" "    iterm-status: $1"; }

ESC=$'\033'
BEL=$'\a'

setting() { echo "$RENDERER_SETTINGS" | jq -r --arg k "$1" '."iterm-status"[$k] // empty'; }

resolve_category() {
  local category
  category=$(setting "$1.$2")
  [ -n "$category" ] || category=$(setting "$1")
  echo "$category"
}

render_status() {
  local tmux_session="$1" client_tty="$2"
  local categories="" pane_id pane_root_pid
  while read -r pane_id pane_root_pid; do
    [ -n "$pane_root_pid" ] || continue
    local session_dir="$ROOT_DATA_DIR/$pane_root_pid"
    [ -f "$session_dir/static.env" ] || continue
    local AGENT_STATE="" CLAUDE_STATE="" USER_STATE=""
    source "$session_dir/state.env" 2>/dev/null
    AGENT_STATE="${AGENT_STATE:-${CLAUDE_STATE:-}}" # read legacy v4 state files
    [ -n "$AGENT_STATE" ] || continue
    local category
    category=$(resolve_category "$AGENT_STATE" "$USER_STATE")
    rlog "pane=$pane_id agent_state=$AGENT_STATE user_state=$USER_STATE category=${category:-none}"
    [ -n "$category" ] && categories+="$category"$'\n'
  done < <(tmux list-panes -s -t "$tmux_session" -F '#{pane_id} #{pane_pid}' 2>/dev/null)

  local top="" text="" category count
  local IFS=','
  for category in $(setting priority); do
    count=$(printf '%s' "$categories" | grep -cx "$category")
    [ "$count" -gt 0 ] || continue
    [ -n "$top" ] || top="$category"
    text+="${text:+ · }$count $category"
  done
  unset IFS

  local tab_status="status=;indicator=;status-color="
  if [ -n "$top" ]; then
    local color; color=$(setting "color.$top")
    tab_status="status=$text;indicator=$color;status-color=$color"
  fi
  rlog "session=$tmux_session $tab_status"
  printf '%s' "${ESC}]0;${tmux_session}${BEL}${ESC}]7501;state=clear${BEL}${ESC}]21337;${tab_status}${BEL}" > "$client_tty"
}

case "$TRIGGER" in
  AGENT_STATE_UPDATE|USER_STATE_UPDATE|REFRESH)
    [ -n "$SESSION_TMUX_SESSION" ] || { rlog "skip (no tmux session)"; exit 0; }
    [ -n "$CLIENT_TTY" ] && [ -e "$CLIENT_TTY" ] || { rlog "skip (no client tty)"; exit 0; }
    render_status "$SESSION_TMUX_SESSION" "$CLIENT_TTY"
    ;;
esac
