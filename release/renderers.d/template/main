#!/bin/bash
# Renderer: <name>
# <one-line description>
#
# Exported variables (do NOT source env files, use these directly):
#
#   Variable              Description                  Example / Values                          Can be empty string?
#   --------------------  ---------------------------  ------------------------------------------ ------
#   TRIGGER               Event triggering this        USER_STATE_UPDATE|AGENT_STATE_UPDATE|REFRESH|STATUS    no
#   RENDER_PID            Shell PID of the session     1009003                                    no
#   ROOT_DATA_DIR         Base runtime data dir        /tmp/agent-notify-jeanlescut               no
#   SESSION_DATA_DIR      Session runtime data dir     /tmp/agent-notify-jeanlescut/1009003       no
#   RENDERER_SETTINGS     Merged JSON settings          {"sound-tts":{"Finished":true}}            no  (defaults to '{}')
#   AGENT_STATE           Agent state                  Working|Finished|WaitingForUser|Idle       ⚠️ yes (before first hook, or after wipe)
#   USER_STATE            User state                   Pending|Seen|Acknowledged|OnHold           ⚠️ yes (before first hook, or after wipe)
#   CLIENT_TTY            TTY of the tmux client       /dev/pts/112                               ⚠️ yes (no client attached)
#   SESSION_TMUX_PANE     Tmux pane id                 %137                                       ⚠️ yes (outside tmux)
#   SESSION_TMUX_SESSION  Tmux session name            notify                                     ⚠️ yes (outside tmux)
#   SESSION_TMUX_WINDOW   Tmux window id               @10                                        ⚠️ yes (outside tmux)
#   AGENT_TYPE            Adapter name                 claude|generic                             no
#   AGENT_SESSION_ID      Native agent session id      44112769-0dc8-489b-b5dc-56e1f4eab079       ⚠️ yes
#   AGENT_WD              Working directory            /home/user/project                         ⚠️ yes
#   AGENT_PID             Agent process PID            458808                                     ⚠️ yes
#   SESSION_NAME          Adapter-resolved title       Refactor notifications                     ⚠️ yes
#
# Read your renderer's settings from RENDERER_SETTINGS with:
#   echo "$RENDERER_SETTINGS" | jq -r '."<renderer-name>".<key>'
#
# To add a real renderer: copy this whole renderers.d/template/ folder to
# renderers.d/<name>/, rename this file's folder (keep it named "main"),
# fill in your logic, then chmod +x renderers.d/<name>/main - install.sh
# does this automatically for every renderer folder except this one.
# This file is deliberately kept non-executable so it's never discovered
# or invoked as a real renderer.

rlog() { log "${RENDER_PID:--}" "    <renderer-name>: $1"; }

case "$TRIGGER" in
  AGENT_STATE_UPDATE)
    # Agent state changed, check $AGENT_STATE for the value
    rlog "trigger=$TRIGGER agent_state=$AGENT_STATE"
    ;;
  USER_STATE_UPDATE)
    # User state changed, check $USER_STATE for the value
    rlog "trigger=$TRIGGER user_state=$USER_STATE"
    ;;
  REFRESH)
    # Periodic refresh, re-render current state
    rlog "trigger=$TRIGGER"
    ;;
esac
