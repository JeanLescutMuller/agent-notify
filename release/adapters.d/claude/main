#!/bin/bash
# Claude Code adapter. This file is sourced by notify, not executed.

adapter_load_context() {
  AGENT_TYPE="claude"
  [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && AGENT_SESSION_ID="$CLAUDE_CODE_SESSION_ID"
  [ -n "${CLAUDE_PROJECT_DIR:-}" ] && AGENT_WD="$CLAUDE_PROJECT_DIR"
}

adapter_resolve_agent_pid() {
  local shell_pid="$1"
  ps -ax -o ppid= -o pid= -o comm= 2>/dev/null | awk -v parent="$shell_pid" '
    $1 == parent {
      command_name=$3
      sub(/^.*\//, "", command_name)
      if (command_name == "claude") { print $2; exit }
    }
  '
}

adapter_resolve_session_name() {
  local session_id="$1"
  [ -n "$session_id" ] || return 0
  python3 "$NOTIFY_DIR/adapters.d/claude/resolve_session_name.py" "$session_id" 2>/dev/null
}

# Claude's Stop event means the parent stopped producing text, not that the
# subagents it dispatched have finished. Claude Code puts the live list in the
# Stop hook's stdin JSON (`background_tasks`, measured on 2.1.317, 2026-11-03):
# a running subagent there defers Finished. When that subagent ends, Claude
# wakes the parent (UserPromptSubmit, then a new Stop with the list emptied),
# so no polling or marker is needed. Background shells are listed too
# (type "shell": a dev server never ends) and never defer Finished.
# stdin is read only here, never from a terminal, and with a 1 s limit. Claude
# Code (Node) passes it on a socket, not a pipe; tmux run-shell's socket and
# /dev/null give end-of-file at once. Anything unreadable or unexpected fails
# open: Finished applies at once.
adapter_has_pending_work() {
  [ -t 0 ] && return 1
  local payload="" running
  IFS= read -r -d '' -t 1 payload || true
  [ -n "$payload" ] || return 1
  running=$(printf '%s' "$payload" | jq '[.background_tasks[]? | select(type == "object" and .type == "subagent" and .status == "running")] | length' 2>/dev/null)
  log "${RENDER_PID:-?}" "pending-work check: ${#payload}-byte payload, running subagents: ${running:-unreadable}"
  [ "${running:-0}" -gt 0 ] 2>/dev/null
}
