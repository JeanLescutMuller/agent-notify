#!/bin/bash
# Agent-agnostic Notify - unified CLI and handler.
#
# Called by:
#   Agent integrations:  notify session-start
#                        notify event <Working|Finished|WaitingForUser|Idle>
#                        notify session-end
#   tmux pane switch:    notify user-focus
#   tmux menu / CLI:     notify status|update|wipe|refresh|<renderer> [--all|--global]
#   init:                notify init  (symlink + tmux hooks, idempotent)
#
# Renderers live one per folder in renderers.d/<name>/, each with its own
# executable (renderers.d/<name>/main) and its own settings.json (unwrapped
# - just that renderer's own block, no "<name>" key needed).

# --- shared variables and functions ----------------------

NOTIFY_VERSION="5.11"  # hardcoded; bump manually per notable change

# Fallbacks fed to renderers by a DELIBERATE state action - update_state_and_render
# (notify update / event / tmux-menu toggle / user-focus) and cmd_settings - never by
# cmd_refresh's automatic REFRESH (session-start, the periodic debounce, `notify
# refresh`). A brand-new session dir, or one that survived a same-session-id resume
# (see cmd_refresh's 2.1), sits with AGENT_STATE/USER_STATE empty until the first
# hook/menu action sets them; every renderer treats empty AGENT_STATE as "nothing to
# render" and ignores USER_STATE entirely (see tmux-pane-bg), so without a default a
# manual tmux-menu toggle in that window would have no visible effect. But applying it
# to cmd_refresh's automatic render too would make every fresh session render as
# AGENT_STATE_DEFAULT (e.g. paint a tmux pane "Finished" green) before the agent has
# done anything - see the 2026-09-01 investigation. So this is applied only inside
# deliberate-action call sites, live, right before their render call, never persisted
# to state.env: this keeps state.env/`notify status` reporting the true on-disk value
# (still empty until a real transition happens), and - more importantly - keeps it out
# of the no-change comparison in update_state_and_render, which must keep seeing the
# raw empty value or a genuine first `event Finished` on a brand-new session would
# equal this default and be silently treated as a no-op instead of a real transition.
AGENT_STATE_DEFAULT="Finished"
USER_STATE_DEFAULT="Pending"

NOTIFY_USER="${USER:-$(whoami)}"
ROOT_DATA_DIR="${NOTIFY_ROOT_DATA_DIR:-/tmp/agent-notify-$NOTIFY_USER}"
NOTIFY_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
RENDERERS_DIR="$NOTIFY_DIR/renderers.d"
ADAPTERS_DIR="$NOTIFY_DIR/adapters.d"
NOTIFY_RUNTIME_DIR="${NOTIFY_RUNTIME_DIR:-$HOME/opt/agent-notify}"
NOTIFY_CONFIG_DIR="${NOTIFY_CONFIG_DIR:-$NOTIFY_RUNTIME_DIR/config}"
GLOBAL_RENDERERS_DIR="$NOTIFY_CONFIG_DIR/renderers.d"
_legacy_root="/tmp/claude-notify-$NOTIFY_USER"
if [ ! -e "$ROOT_DATA_DIR" ] && [ -d "$_legacy_root" ]; then
  mv "$_legacy_root" "$ROOT_DATA_DIR"
fi
mkdir -p "$ROOT_DATA_DIR"

##### Logger
# Exported so every renderer subprocess inherits it directly - a renderer's
# own rlog() just calls this with its name as part of the message prefix,
# instead of reimplementing the timestamp/printf/redirect logic itself.
log() { local pid="$1" msg="$2"; printf '%s [%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$pid" "$msg" >> "$ROOT_DATA_DIR/notify.log" 2>/dev/null; }
export -f log

# One-line stdout confirmation for commands a human types (update, wipe,
# refresh, <renderer>). SAY is switched on only by those dispatch arms, so
# hook-driven calls (session-start, event, session-end, user-focus, init)
# stay silent: Claude injects SessionStart hook stdout into the chat and tmux
# run-shell pops any stdout up over the pane. NOTIFY_QUIET=true silences it
# for scripted callers such as the tmux popup menu.
SAY=false
say() { $SAY && [ "${NOTIFY_QUIET:-false}" != "true" ] && printf '%s\n' "$*"; return 0; }

##### Agent adapter context #####
# Claude Code sets CLAUDE_CODE_SESSION_ID and CLAUDE_PROJECT_DIR as plain
# environment variables on every hook command invocation (confirmed via
# direct inspection - NOT documented, and NOT delivered via stdin the way a
# hook's JSON payload usually is for other integrations, so don't assume
# this generalizes to a different hook style). From these we can locate this
# session's own transcript file - the ONLY reliable source for
# the Claude adapter to detect outstanding dispatched subagents.
# Fast path: Claude Code's own project-dir encoding is "/" -> "-" with a
# leading "-" (confirmed for two real paths); verify the guess against the
# filesystem and fall back to a bounded search by session id if it's ever
# wrong (untested edge cases: dots, spaces, unusual characters in the path).
AGENT_TYPE="${NOTIFY_AGENT_TYPE:-}"
if [ -z "$AGENT_TYPE" ] && [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then AGENT_TYPE="claude"; fi
AGENT_TYPE="${AGENT_TYPE:-generic}"
load_adapter() {
  local type="$1"
  ADAPTER="$ADAPTERS_DIR/$type/main"
  [ -f "$ADAPTER" ] || { echo "Unknown agent adapter: $type" >&2; exit 1; }
  # Optional freshness callback; reset it when switching adapters in --all.
  adapter_refresh_session_name() { return 0; }
  source "$ADAPTER"
}
load_adapter "$AGENT_TYPE"
AGENT_SESSION_ID="${AGENT_SESSION_ID:-}"
AGENT_WD="${AGENT_WD:-}"
AGENT_PID="${AGENT_PID:-}"
ADAPTER_TRANSCRIPT_PATH=""
adapter_load_context

# Loading saved sessions changes AGENT_* and the active adapter. Capture the
# invocation ONCE, before a --all loop can replace it with a neighbor's data.
INVOKING_AGENT_TYPE="$AGENT_TYPE"
INVOKING_SESSION_ID="$AGENT_SESSION_ID"
INVOKING_AGENT_WD="$AGENT_WD"
INVOKING_AGENT_PID="$AGENT_PID"

##### Managed block helpers (used by `init` for the tmux hooks block) #####
# Same box + hash + remove-then-reconstruct convention used across every
# project that injects a block into a config file it doesn't fully own -
# see also bootstrap-home's bootstrap.sh, which shares this exact format.

_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{print $1}'
  else shasum -a 256 | awk '{print $1}'; fi
}

# Idempotently manages a box-delimited, hash-verified block in $1 (target
# file) labeled $2 (e.g. "AGENT-NOTIFY"), containing $3 (desired content).
# Removes and reconstructs the block every time it's called - never
# touches anything outside it. If the block was hand-edited since it was
# last written (hash mismatch), leaves the file untouched, prints a diff,
# and returns non-zero instead of overwriting the edit.
deploy_managed_block() {
  local target="$1" label="$2" desired="$3"
  local top="# ┌─ ${label} BLOCK ─────────────────────────────────────────────"

  local desired_hash
  desired_hash="$(printf '%s\n' "$desired" | _sha256)"

  local current="" recorded_hash=""
  if [ -f "$target" ] && grep -qF "$top" "$target"; then
    current="$(awk -v top="$top" '
      $0==top { inblock=1; next }
      inblock && /^# └/ { inblock=0; next }
      inblock && /^# [┌│]/ { next }
      inblock { print }
    ' "$target")"
    recorded_hash="$(grep -F "${label} BLOCK END" "$target" | sed -E 's/.*sha256:([0-9a-f]+).*/\1/')"
  fi

  if [ -n "$recorded_hash" ] && [ "$(printf '%s\n' "$current" | _sha256)" != "$recorded_hash" ]; then
    echo "WARNING: the ${label} block in $target was hand-edited since it was" >&2
    echo "last deployed - leaving it untouched. Diff (current vs. what would" >&2
    echo "be deployed):" >&2
    diff <(printf '%s\n' "$current") <(printf '%s\n' "$desired") | sed 's/^/    /' >&2
    return 1
  fi

  if [ "$current" = "$desired" ] && [ -n "$recorded_hash" ]; then
    return 0
  fi

  [ -f "$target" ] && cp "$target" "${target}.bak.$(date +%Y%m%d_%H%M%S)"

  if [ -f "$target" ] && grep -qF "$top" "$target"; then
    awk -v top="$top" '
      $0==top { inblock=1; next }
      inblock && /^# └/ { inblock=0; next }
      inblock { next }
      { print }
    ' "$target" > "${target}.tmp" && mv "${target}.tmp" "$target"
  fi

  # Trim trailing blank lines left over from a previous deploy, so the
  # blank-line separator below never accumulates across re-installs.
  if [ -f "$target" ]; then
    awk '{ l[NR]=$0 } END { n=NR; while (n>0 && l[n]=="") n--; for (i=1;i<=n;i++) print l[i] }' \
      "$target" > "${target}.tmp" && mv "${target}.tmp" "$target"
  fi

  {
    [ -s "$target" ] && echo ""
    echo "$top"
    echo "# │ DO NOT EDIT - auto-generated by notify. Edits inside this"
    echo "# │ block are overwritten on every install. Put your own"
    echo "# │ customizations below this block instead."
    printf '%s\n' "$desired"
    echo "# │ ${label} BLOCK END — sha256:${desired_hash}"
    echo "# └────────────────────────────────────────────────────────────"
  } >> "$target"
  return 0
}

migrate_managed_block_label() {
  local target="$1" old_label="$2" new_label="$3"
  [ -f "$target" ] || return 0
  grep -qF "# ┌─ ${old_label} BLOCK" "$target" || return 0
  grep -qF "# ┌─ ${new_label} BLOCK" "$target" && return 0
  sed "s/${old_label}/${new_label}/g" "$target" > "$target.tmp" && mv "$target.tmp" "$target"
}

##### Command Helpers #####

read_and_export_static() {
  local RENDER_PID="$1"
  SESSION_DATA_DIR="$ROOT_DATA_DIR/$RENDER_PID"
  AGENT_TYPE=""
  AGENT_SESSION_ID=""
  AGENT_WD=""
  AGENT_PID=""
  SESSION_NAME=""
  SESSION_TMUX_PANE=""
  SESSION_TMUX_WINDOW=""
  SESSION_TMUX_SESSION=""
  TRANSCRIPT_PATH=""
  [ -f "$SESSION_DATA_DIR/static.env" ] && source "$SESSION_DATA_DIR/static.env"
  # Read legacy v4 session files during the in-place migration.
  AGENT_SESSION_ID="${AGENT_SESSION_ID:-${CLAUDE_UUID:-}}"
  AGENT_WD="${AGENT_WD:-${CLAUDE_WD:-}}"
  AGENT_PID="${AGENT_PID:-${CLAUDE_PID:-}}"
  SESSION_NAME="${SESSION_NAME:-}"
  AGENT_TYPE="${AGENT_TYPE:-claude}"
  load_adapter "$AGENT_TYPE"
  export SESSION_DATA_DIR SHELL_PID AGENT_TYPE AGENT_SESSION_ID AGENT_WD AGENT_PID SESSION_NAME SESSION_TMUX_PANE SESSION_TMUX_WINDOW SESSION_TMUX_SESSION TRANSCRIPT_PATH
}

# Refresh the loaded session's name without re-resolving unrelated metadata.
# Only adapters opting into the callback do work. Repeated identical agent
# states skip renderer dispatch entirely, so tool hooks do not poll the index.
refresh_session_name() {
  local previous="$SESSION_NAME" f="$SESSION_DATA_DIR/static.env" tmp
  adapter_refresh_session_name
  export SESSION_NAME
  [ "$SESSION_NAME" != "$previous" ] && [ -f "$f" ] || return 0
  tmp="$(mktemp "$f.XXXXXX")" || return 0
  if { sed '/^SESSION_NAME=/d' "$f" && printf 'SESSION_NAME=%q\n' "$SESSION_NAME"; } > "$tmp"; then
    mv -f "$tmp" "$f" || rm -f "$tmp"
  else
    rm -f "$tmp"
  fi
}

# Persists ADAPTER_TRANSCRIPT_PATH (this invocation's adapter context) into
# RENDER_PID's static.env, if it's set and different from what's already
# there. Cheap no-op otherwise, so safe to call on every hook-driven update -
# this is the ONLY place TRANSCRIPT_PATH gets written outside of cmd_refresh's
# full static rewrite, since most hook events (PreToolUse, Stop, Notification)
# never go through cmd_refresh at all.
persist_transcript_path() {
  local RENDER_PID="$1" f="$ROOT_DATA_DIR/$RENDER_PID/static.env"
  [ -n "$ADAPTER_TRANSCRIPT_PATH" ] && [ -f "$f" ] || return 0
  local line
  printf -v line 'TRANSCRIPT_PATH=%q' "$ADAPTER_TRANSCRIPT_PATH"
  grep -qxF "$line" "$f" 2>/dev/null && return 0
  { grep -v '^TRANSCRIPT_PATH=' "$f" 2>/dev/null; echo "$line"; } > "$f.tmp" && mv "$f.tmp" "$f"
}

# Detects subagents dispatched (via the Agent tool) by RENDER_PID's own
# session that haven't completed yet, per that session's own transcript.
# See HISTORY.md ("Subagent completion tracking") for the full investigation -
# short version: a dispatched agent's tool_result always contains a literal
# "agentId: <hex>" line; the moment that agent's underlying task actually
# completes (whether or not the parent has looked at it yet), Claude Code
# itself appends a {"type":"queue-operation","operation":"enqueue",...,
# "content":"...<task-id><hex></task-id>...<status>completed</status>..."}
# entry to the SAME transcript - authoritative, low-latency, and unlike a
# subagent's own hooks (which never fire on completion - see HISTORY.md), this
# is written reliably because the parent's own transcript is what's doing
# the writing. Bounded to a tail window of the transcript for speed (the
# Stop hook's own timeout is 2s in plugin.json) - a subagent dispatched
# further back than that window would be missed; same class of tradeoff as
# the Claude session-name resolver's backward chunk scan.
# Returns 0 (true - still pending) or 1 (false - nothing outstanding).
has_pending_work() { adapter_has_pending_work "$1"; }

# If RENDER_PID owes a suppressed Finished (see cmd_update_state) and its
# subagents have since cleared, applies it now and clears the marker. Called
# both reactively (start of cmd_update_state, so the session's own next hook
# event resolves it) and proactively (end of cmd_refresh, so it resolves even
# if the session stays completely silent - see HISTORY.md, this is what makes
# the fix work for the T6/T8/T10-style "parent goes idle" case).
try_resolve_pending_finish() {
  local RENDER_PID="$1" session_dir="$ROOT_DATA_DIR/$1"
  [ -f "$session_dir/pending_finish" ] || return 0
  read_and_export_static "$RENDER_PID"
  if has_pending_work "$TRANSCRIPT_PATH"; then
    return 0
  fi
  rm -f "$session_dir/pending_finish"
  log "$RENDER_PID" "pending_finish resolved (subagents cleared) - applying Finished"
  update_state_and_render "$RENDER_PID" "AGENT_STATE" "Finished" true
}

read_and_export_state() {
  local RENDER_PID="$1"
  SESSION_DATA_DIR="$ROOT_DATA_DIR/$RENDER_PID"
  AGENT_STATE=""
  USER_STATE=""
  [ -f "$SESSION_DATA_DIR/state.env" ] && source "$SESSION_DATA_DIR/state.env"
  AGENT_STATE="${AGENT_STATE:-${CLAUDE_STATE:-}}"
  export AGENT_STATE USER_STATE
}

# Reads AGENT_STATE straight off RENDER_PID's state.env on disk, bypassing a
# caller's own (possibly stale, captured-earlier) exported copy. Exported so
# renderer child processes can call it directly - e.g. sound-bell/sound-tts's
# WaitingForUser debounce, re-checking state right before actually alerting -
# without re-sourcing the whole file or re-implementing this lookup per
# renderer (same convention as log()'s own export -f above). Plain grep/cut
# rather than read_and_export_state's source: cheaper for one field, and
# never executes state.env as shell code (see CLAUDE.md's trust-boundary
# note) for a check a renderer performs on every debounced wait.
current_agent_state() {
  grep -m1 '^AGENT_STATE=' "$ROOT_DATA_DIR/$1/state.env" 2>/dev/null | cut -d= -f2-
}
export -f current_agent_state

resolve_client_tty() {
  CLIENT_TTY=""
  if [ -n "$SESSION_TMUX_SESSION" ]; then
    CLIENT_TTY=$(tmux list-clients -t "$SESSION_TMUX_SESSION" -F '#{client_activity} #{client_tty}' 2>/dev/null | sort -rn | head -1 | awk '{print $2}')
  fi
  # Fall back to the PID-based lookup whenever the tmux-based one above didn't
  # produce a tty - not only when SESSION_TMUX_SESSION was unset (this used to
  # be an elif). A stale SESSION_TMUX_SESSION - e.g. after a
  # `tmux rename-session` before this session's static.env got refreshed, see
  # cmd_refresh - makes `tmux list-clients -t <stale name>` fail silently,
  # which previously left CLIENT_TTY empty with no recovery.
  if [ -z "$CLIENT_TTY" ] && [ -n "$SHELL_PID" ] && [ "$SHELL_PID" != "-" ]; then
    # "ps -o tty=" works on both macOS (BSD ps) and Linux (GNU ps); /proc doesn't exist on macOS.
    local _tty_name
    _tty_name=$(ps -o tty= -p "$SHELL_PID" 2>/dev/null | tr -d ' ')
    [ -n "$_tty_name" ] && [ "$_tty_name" != "??" ] && CLIENT_TTY="/dev/$_tty_name"
  fi
  export CLIENT_TTY
}

# Assembles the combined { "<renderer>": {...}, ... } settings object from
# immutable defaults, persistent global overrides, and session overrides.
resolve_renderer_settings() {
  local RENDER_PID="$1"
  local session_renderers_dir="$ROOT_DATA_DIR/$RENDER_PID/renderers.d"

  RENDERER_SETTINGS='{}'
  local dir renderer content gfile ofile
  for dir in "$RENDERERS_DIR"/*/; do
    renderer="$(basename "$dir")"
    [ -x "$dir/main" ] || continue
    content='{}'
    [ -f "$dir/settings.json" ] && content=$(cat "$dir/settings.json")
    gfile="$GLOBAL_RENDERERS_DIR/$renderer/settings.json"
    [ -f "$gfile" ] && content=$(jq -s '.[0] * .[1]' <(printf '%s' "$content") "$gfile" 2>/dev/null)
    ofile="$session_renderers_dir/$renderer/settings.json"
    [ -f "$ofile" ] && content=$(jq -s '.[0] * .[1]' <(printf '%s' "$content") "$ofile" 2>/dev/null)
    RENDERER_SETTINGS=$(echo "$RENDERER_SETTINGS" | jq --arg r "$renderer" --argjson v "$content" '.[$r] = $v' 2>/dev/null)
  done
  export RENDERER_SETTINGS
}

call_all_renderers() {
  local RENDER_PID="$1"
  case "$2" in
    AGENT_STATE) export TRIGGER="AGENT_STATE_UPDATE" ;;
    USER_STATE)   export TRIGGER="USER_STATE_UPDATE" ;;
    *)            export TRIGGER="$2" ;;
  esac
  [ "$TRIGGER" = "AGENT_STATE_UPDATE" ] && refresh_session_name
  export RENDER_PID ROOT_DATA_DIR SESSION_DATA_DIR
  resolve_client_tty
  resolve_renderer_settings "$RENDER_PID"
  local renderer enabled
  for renderer in $(echo "$RENDERER_SETTINGS" | jq -r 'keys[]'); do
    [ -x "$RENDERERS_DIR/$renderer/main" ] || continue
    enabled=$(echo "$RENDERER_SETTINGS" | jq -r --arg r "$renderer" 'if .[$r] | has("enabled") then .[$r].enabled else true end')
    if [ "$enabled" = "false" ]; then
      log "$RENDER_PID" "RENDER $TRIGGER $renderer skip (disabled)"
      continue
    fi
    log "$RENDER_PID" "RENDER $TRIGGER $renderer"
    "$RENDERERS_DIR/$renderer/main"
  done
}

update_state_and_render() {
  local RENDER_PID="$1" key="$2" val="$3" force="${4:-false}"
  local session_dir="$ROOT_DATA_DIR/$RENDER_PID"

  # Read once. Load Disk vals, and new vals
  read_and_export_state "$RENDER_PID"
  AGENT_STATE_DISK="$AGENT_STATE"
  USER_STATE_DISK="$USER_STATE"
  printf -v "$key" '%s' "$val" # Assign "$val" to the variable named in "$key" (safer than eval)

  # Guardrails
  # Changing agent state: move user state back to pending, except if manually put on hold
  if [ "$AGENT_STATE_DISK" != "$AGENT_STATE" ] && [ "$USER_STATE_DISK" != "OnHold" ]; then
    USER_STATE="Pending"
  fi
  # Never downgrade a user state from acknowledged to seen
  if [ "$USER_STATE_DISK" = "Acknowledged" ] && [ "$USER_STATE" = "Seen" ]; then
    USER_STATE="$USER_STATE_DISK"
  fi
  # Never downgrade an on-hold state to seen or acknowledged via an AUTOMATIC
  # update (tmux pane/window focus - see the `user-focus` case, which always
  # calls this with force=false, i.e. unset/default) - that's the whole point
  # of OnHold: glancing at or clicking through panes shouldn't clear it.
  # force=true (only cmd_update_state passes it - the `update` subcommand
  # behind both the tmux popup menu and manual `notify update USER_STATE ...`)
  # bypasses ONLY this one guardrail, not the others above: it means "this is
  # a deliberate human request for this exact value, not an automatic side
  # effect" and must be allowed to leave OnHold, or picking "Acknowledge" from
  # the menu while on hold would silently do nothing.
  if [ "$force" != "true" ] && [ "$USER_STATE_DISK" = "OnHold" ] && { [ "$USER_STATE" = "Seen" ] || [ "$USER_STATE" = "Acknowledged" ]; }; then
    USER_STATE="$USER_STATE_DISK"
  fi

  # No-change check
  if [ "$AGENT_STATE" = "$AGENT_STATE_DISK" ] && [ "$USER_STATE" = "$USER_STATE_DISK" ] ; then
    return 1
  fi

  # Write update to file
  echo "AGENT_STATE=$AGENT_STATE" > "$session_dir/state.env"
  echo "USER_STATE=$USER_STATE" >> "$session_dir/state.env"

  # Render. Substitute AGENT_STATE_DEFAULT/USER_STATE_DEFAULT for whichever
  # axis this update left empty (e.g. a USER_STATE-only change - tmux focus,
  # menu action - on a session with no AGENT_STATE transition yet) - after
  # the write above, so state.env keeps recording the true (possibly still
  # empty) value. See the defaults' own comment for why this must stay after
  # the no-change check too.
  AGENT_STATE="${AGENT_STATE:-$AGENT_STATE_DEFAULT}" USER_STATE="${USER_STATE:-$USER_STATE_DEFAULT}"
  export AGENT_STATE USER_STATE
  read_and_export_static "$RENDER_PID"
  call_all_renderers "$RENDER_PID" "$key"
}

# --- commands --------------------------------------------

cmd_refresh() {
  local RENDER_PID="$1"
  local session_dir="$ROOT_DATA_DIR/$RENDER_PID"
  local invocation_agent_type="$INVOKING_AGENT_TYPE"
  local invocation_session_id="$INVOKING_SESSION_ID"
  local invocation_agent_wd="$INVOKING_AGENT_WD"
  local invocation_agent_pid="$INVOKING_AGENT_PID"
  log "$RENDER_PID" "refresh"

  read_and_export_static "$RENDER_PID"
  local disk_session_id="$AGENT_SESSION_ID"

  # 1. We are NOT refreshing the current PID ? --> Wipe if Dead Session
  if [ "$RENDER_PID" != "$CURRENT_PID" ]; then
    if ! kill -0 "$RENDER_PID" 2>/dev/null; then
      log "$RENDER_PID" "PRUNED dead"
      rm -rf "$session_dir"
      return
    fi

  # 2. We are refreshing the current PID ? --> Refresh agent/tmux-pane statics
  #
  # `refresh --all` calls cmd_refresh once per session dir, but from a SINGLE
  # process - so $PWD / $TMUX_PANE / $CLAUDE_CODE_SESSION_ID always describe
  # whichever session happened to trigger the loop, never the RENDER_PID
  # currently being iterated. Applying them to another session's PID would
  # silently corrupt that session's agent metadata or SESSION_TMUX_PANE
  # with the invoker's own - so 2.1/2.2 below must stay gated to CURRENT_PID.
  else
    # 2.1 If the adapter supplied a session id, detect reuse of the shell and
    # refresh agent metadata without teaching the core any native hook format.
    if [ ! -f "$session_dir/static.env" ] || [ -n "$invocation_session_id" ] || [ "$invocation_agent_type" != "generic" ]; then
      if [ -n "$disk_session_id" ] && [ "$disk_session_id" != "$invocation_session_id" ]; then
        log "$RENDER_PID" "stale session (old agent_session_id=$disk_session_id), wiping"
        rm -rf "$session_dir"
        read_and_export_static "$RENDER_PID" # Reset statics
      fi
      AGENT_TYPE="$invocation_agent_type"
      load_adapter "$AGENT_TYPE"
      AGENT_SESSION_ID="$invocation_session_id"
      AGENT_PID="${invocation_agent_pid:-$(adapter_resolve_agent_pid "$RENDER_PID")}"
      AGENT_WD="${invocation_agent_wd:-$PWD}"
      SESSION_NAME="$(adapter_resolve_session_name "$AGENT_SESSION_ID")"
    fi
    # 2.2 If we have TMUX_PANE loaded by Tmux, refresh it
    if [ -n "$TMUX_PANE" ]; then
        SESSION_TMUX_PANE="$TMUX_PANE"
    fi
  fi

  # 3. Re-derive SESSION_TMUX_SESSION/WINDOW from SESSION_TMUX_PANE, for ANY
  # RENDER_PID - including under `refresh --all`, unlike 2.1/2.2 above. This is
  # safe because SESSION_TMUX_PANE at this point is either RENDER_PID's own
  # value loaded from disk by read_and_export_static (top of this function),
  # or, for CURRENT_PID, just-refreshed in 2.2 - either way it's the correct
  # pane for THIS session, never the invoker's. tmux pane IDs (%N) are global
  # identifiers any process can query regardless of who's asking, so this is
  # what keeps SESSION_TMUX_SESSION/WINDOW from going stale after a
  # `tmux rename-session`. Before this was pulled out of the CURRENT_PID-only
  # branch, only CURRENT_PID's session/window ever got re-derived, so every
  # OTHER session's tmux-based renderers (terminal-title, sound-bell,
  # sound-tts - anything going through resolve_client_tty) would silently stop
  # working after a rename, since `tmux list-clients -t <stale name>` fails
  # with no fallback (see notify.log investigation, SHELL_PID 78830, 2026-08-18).
  if [ -n "$SESSION_TMUX_PANE" ]; then
    SESSION_TMUX_SESSION=$(tmux display-message -t "$SESSION_TMUX_PANE" -p '#S' 2>/dev/null)
    SESSION_TMUX_WINDOW=$(tmux display-message -t "$SESSION_TMUX_PANE" -p '#{window_id}' 2>/dev/null)
  fi

  # 4. Write on Disk
  if [ "$RENDER_PID" = "$CURRENT_PID" ] && [ -n "$ADAPTER_TRANSCRIPT_PATH" ]; then
    TRANSCRIPT_PATH="$ADAPTER_TRANSCRIPT_PATH"
  fi
  mkdir -p "$session_dir"
  f="$session_dir/static.env"
  # Every value is %q-escaped: the file is sourced, and a tmux session name
  # with a space ("WhatsApp skill") used to load as empty.
  {
    printf 'TIMESTAMP=%q\n' "$(date '+%Y-%m-%dT%H:%M:%S')"
    printf 'SHELL_PID=%q\n' "$RENDER_PID"
    printf 'AGENT_TYPE=%q\n' "$AGENT_TYPE"
    printf 'AGENT_SESSION_ID=%q\n' "$AGENT_SESSION_ID"
    printf 'AGENT_WD=%q\n' "$AGENT_WD"
    printf 'AGENT_PID=%q\n' "$AGENT_PID"
    printf 'SESSION_NAME=%q\n' "$SESSION_NAME"
    printf 'SESSION_TMUX_PANE=%q\n' "$SESSION_TMUX_PANE"
    printf 'SESSION_TMUX_WINDOW=%q\n' "$SESSION_TMUX_WINDOW"
    printf 'SESSION_TMUX_SESSION=%q\n' "$SESSION_TMUX_SESSION"
    printf 'TRANSCRIPT_PATH=%q\n' "$TRANSCRIPT_PATH"
  } > "$f"

  # 5. Refresh Renderers. Raw (possibly empty) state, deliberately not defaulted -
  # see AGENT_STATE_DEFAULT's comment: this is the automatic path, and a fresh
  # session must render as "nothing to report" until a real transition happens.
  read_and_export_state "$RENDER_PID"
  call_all_renderers "$RENDER_PID" "REFRESH"

  # 6. Proactive half of subagent-completion tracking: catches a suppressed
  # Finished even if this session's own hooks never fire again (see
  # try_resolve_pending_finish and the debounce-interval tightening below).
  try_resolve_pending_finish "$RENDER_PID"
}

cmd_status() {
  local RENDER_PID="$1"
  [ -n "$CMD_ARG1" ] && { echo "Usage: notify status [--all]  (to change a value, use: notify event <state>, notify update <AGENT_STATE|USER_STATE> <value>, or notify <renderer> ...)"; exit 1; }
  [ ! -d "$ROOT_DATA_DIR/$RENDER_PID" ] && cmd_refresh "$RENDER_PID"

  read_and_export_static "$RENDER_PID"
  refresh_session_name
  read_and_export_state "$RENDER_PID"
  resolve_client_tty

  echo "== General =="
  printf "  VERSION       %s\n" "$NOTIFY_VERSION"
  printf "  RENDER_PID    %s\n" "$RENDER_PID"
  printf "  AGENT_STATE   %s\n" "${AGENT_STATE:-(none)}"
  printf "  USER_STATE    %s\n" "${USER_STATE:-(none)}"
  printf "  AGENT_TYPE    %s\n" "${AGENT_TYPE:-(none)}"
  printf "  SESSION_ID    %s\n" "${AGENT_SESSION_ID:-(none)}"
  printf "  AGENT_WD      %s\n" "${AGENT_WD:-(none)}"
  printf "  AGENT_PID     %s\n" "${AGENT_PID:-(none)}"
  printf "  SESSION_NAME  %s\n" "${SESSION_NAME:-(none)}"
  printf "  TMUX_SESSION  %s\n" "${SESSION_TMUX_SESSION:-(none)}"
  printf "  TMUX_PANE     %s\n" "${SESSION_TMUX_PANE:-(none)}"
  printf "  CLIENT_TTY    %s\n" "${CLIENT_TTY:-(none)}"

  export RENDER_PID ROOT_DATA_DIR SESSION_DATA_DIR
  resolve_renderer_settings "$RENDER_PID"

  local session_renderers_dir="$ROOT_DATA_DIR/$RENDER_PID/renderers.d"
  local dir renderer gfile ofile out enabled state_label
  for dir in "$RENDERERS_DIR"/*/; do
    renderer="$(basename "$dir")"
    [ -x "$dir/main" ] || continue
    gfile="$GLOBAL_RENDERERS_DIR/$renderer/settings.json"
    ofile="$session_renderers_dir/$renderer/settings.json"
    enabled=$(echo "$RENDERER_SETTINGS" | jq -r --arg r "$renderer" 'if .[$r] | has("enabled") then .[$r].enabled else true end')
    state_label="enabled"; [ "$enabled" = "false" ] && state_label="disabled"

    echo
    echo "== $renderer: $state_label =="
    echo "  -- Default --"
    printf "  %s\n" "$([ -f "$dir/settings.json" ] && jq -c . "$dir/settings.json" 2>/dev/null || echo '{}')"
    if [ -f "$gfile" ]; then
      echo "  -- Global override --"
      printf "  %s\n" "$(jq -c . "$gfile" 2>/dev/null)"
    fi
    if [ -f "$ofile" ]; then
      echo "  -- Session override --"
      printf "  %s\n" "$(jq -c . "$ofile" 2>/dev/null)"
    fi
    # Opt-in: a renderer may implement a STATUS case to print computed info
    # (e.g. sound-tts prints the name it would speak and why). Most
    # renderers don't implement it - harmless no output.
    out=$(TRIGGER=STATUS "$dir/main" 2>/dev/null)
    if [ -n "$out" ]; then
      echo "  -- Status --"
      echo "$out" | sed 's/^/  /'
    fi
  done
}

cmd_update_state() {
  local RENDER_PID="$1"
  [ "$CMD_ARG1" = "CLAUDE_STATE" ] && CMD_ARG1="AGENT_STATE" # v4 compatibility
  case "$CMD_ARG1" in
    AGENT_STATE|USER_STATE) ;;
    *) echo "Usage: notify update <AGENT_STATE|USER_STATE> <value> [--all]"; exit 1 ;;
  esac
  [ ! -d "$ROOT_DATA_DIR/$RENDER_PID" ] && cmd_refresh "$RENDER_PID"
  [ -z "$CMD_ARG2" ] && { echo "Usage: notify update <AGENT_STATE|USER_STATE> <value> [--all]"; exit 1; }
  persist_transcript_path "$RENDER_PID"
  # Reactive half of subagent-completion tracking (see try_resolve_pending_finish):
  # any hook firing again for this session is a chance to apply a Finished
  # that was suppressed earlier, before processing whatever this call itself
  # is asking for.
  try_resolve_pending_finish "$RENDER_PID"

  # Don't let Stop's "the main turn ended" get reported as Finished while this
  # session has dispatched subagents (fork or otherwise) that haven't
  # completed yet, per its own transcript - see HISTORY.md ("Subagent completion
  # tracking") for the full writeup. Suppress the transition and remember to
  # retry via try_resolve_pending_finish instead of reporting done-when-not.
  if [ "$CMD_ARG1" = "AGENT_STATE" ] && [ "$CMD_ARG2" = "Finished" ]; then
    read_and_export_static "$RENDER_PID"
    if has_pending_work "$TRANSCRIPT_PATH"; then
      touch "$ROOT_DATA_DIR/$RENDER_PID/pending_finish"
      log "$RENDER_PID" "update AGENT_STATE Finished suppressed (agent still has pending work)"
      say "AGENT_STATE=Finished deferred: subagents still running (session $RENDER_PID)"
      return
    fi
  fi

  log "$RENDER_PID" "update $CMD_ARG1 $CMD_ARG2"
  # force=true: this command is a direct, deliberate request (CLI or tmux
  # menu), not an automatic side effect - see the OnHold guardrail comment
  # in update_state_and_render.
  update_state_and_render "$RENDER_PID" "$CMD_ARG1" "$CMD_ARG2" true || {
    local result=$?
    # No state change is a successful idempotent request. In particular,
    # selecting the already-active popup item must not make tmux report that
    # its run-shell command failed.
    [ "$result" -eq 1 ] && { say "$CMD_ARG1 already $CMD_ARG2 (session $RENDER_PID)"; return 0; }
    return "$result"
  }
  say "$CMD_ARG1=$CMD_ARG2 (session $RENDER_PID)"
}

# Human-facing wrappers: cmd_refresh/cmd_wipe also run from hooks and from
# other commands, so their confirmation lives here rather than inside them.
user_refresh() {
  cmd_refresh "$1"
  if [ -d "$ROOT_DATA_DIR/$1" ]; then say "refreshed (session $1)"
  else say "pruned dead session $1"; fi
}

user_wipe() {
  if [ -d "$ROOT_DATA_DIR/$1" ]; then cmd_wipe "$1"; say "wiped (session $1)"
  else say "nothing to wipe (session $1)"; fi
}

cmd_wipe() {
  local RENDER_PID="$1"
  [ -d "$ROOT_DATA_DIR/$RENDER_PID" ] || return
  log "$RENDER_PID" "wipe"
  read_and_export_static "$RENDER_PID"
  rm -rf "$ROOT_DATA_DIR/$RENDER_PID"
  AGENT_STATE=""
  USER_STATE=""
  export AGENT_STATE USER_STATE
  call_all_renderers "$RENDER_PID" "REFRESH"
  log "$RENDER_PID" "cleaned up"
}

# Bare renderer name is the command itself, e.g. `notify sound-tts enable`.
# CMD is the renderer name, CMD_ARG1 the action (on/off/enable/disable/key=val),
# CMD_ARG2 + CMD_EXTRA_ARGS any further key=val pairs.
#
# --global writes to the persistent user configuration under NOTIFY_CONFIG_DIR.
# Without --global, writes to that renderer's own settings.json under the
# session's renderers.d/<name>/ dir - same renderer-oriented layout, one
# directory per renderer, so a renderer can drop other per-session files of
# its own there later without needing a new convention. Both settings.json
# override files are unwrapped (just the renderer's own keys) and the same shape.
cmd_settings() {
  local renderer="$CMD"
  if [ ! -x "$RENDERERS_DIR/$renderer/main" ]; then
    echo "Unknown command or renderer: $renderer"
    echo "Usage: notify <init|session-start|event|session-end|user-focus|status|wipe|update|refresh|<renderer>> [args...] [--all|--global]"
    exit 1
  fi

  local target
  if [ "$1" = "_global" ]; then
    mkdir -p "$GLOBAL_RENDERERS_DIR/$renderer"
    target="$GLOBAL_RENDERERS_DIR/$renderer/settings.json"
  else
    RENDER_PID="$1"
    [ ! -d "$ROOT_DATA_DIR/$RENDER_PID" ] && cmd_refresh "$RENDER_PID"
    mkdir -p "$ROOT_DATA_DIR/$RENDER_PID/renderers.d/$renderer"
    target="$ROOT_DATA_DIR/$RENDER_PID/renderers.d/$renderer/settings.json"
  fi
  [ -f "$target" ] || echo '{}' > "$target" # Create file if not exist

  if [ -z "$CMD_ARG1" ]; then
    cat "$target" # No action --> Just show
    return
  fi

  case "$CMD_ARG1" in
    on|enable)   local action="enabled=true" ;;
    off|disable) local action="enabled=false" ;;
    *)           local action="$CMD_ARG1" ;;
  esac
  local changed=()
  for kv in "$action" "$CMD_ARG2" "${CMD_EXTRA_ARGS[@]}"; do
    [[ "$kv" == *=* ]] || continue
    changed+=("$kv")
    local k="${kv%%=*}" v="${kv#*=}"
    if echo "$v" | grep -qE '^[0-9]+$|^true$|^false$'; then
      jq --arg k "$k" --argjson v "$v" '.[$k] = $v' "$target" > "$target.tmp" && mv "$target.tmp" "$target"
    else
      jq --arg k "$k" --arg v "$v" '.[$k] = $v' "$target" > "$target.tmp" && mv "$target.tmp" "$target"
    fi
    log "${RENDER_PID:--}" "settings $renderer.$k=$v"
  done
  if [ "${#changed[@]}" -eq 0 ]; then
    say "$renderer: nothing changed (expected enable, disable or key=value)"
  elif [ -n "$RENDER_PID" ]; then
    say "$renderer: ${changed[*]} (session $RENDER_PID)"
  else
    say "$renderer: ${changed[*]} (global, all sessions)"
  fi

  # Refresh render (if not a change of the global settings)
  if [ -n "$RENDER_PID" ]; then
    read_and_export_static "$RENDER_PID"
    read_and_export_state "$RENDER_PID"
    AGENT_STATE="${AGENT_STATE:-$AGENT_STATE_DEFAULT}" USER_STATE="${USER_STATE:-$USER_STATE_DEFAULT}"
    export AGENT_STATE USER_STATE
    call_all_renderers "$RENDER_PID" "REFRESH"
  fi
}

# --- scope resolution + dispatch -----------------------------------

ALL=false
GLOBAL=false
ARGS=()
for arg in "$@"; do
  case "$arg" in --all) ALL=true ;; --global) GLOBAL=true ;; *) ARGS+=("$arg") ;; esac
done
CMD="${ARGS[0]:-status}"
CMD_ARG1="${ARGS[1]:-}"
CMD_ARG2="${ARGS[2]:-}"
CMD_EXTRA_ARGS=("${ARGS[@]:3}")

CURRENT_PID="${NOTIFY_RENDER_PID:-}"
if [ -n "$CURRENT_PID" ] && ! [[ "$CURRENT_PID" =~ ^[0-9]+$ ]]; then
  echo "NOTIFY_RENDER_PID must be numeric." >&2
  exit 1
fi
_fallback_pid=""
walk_pid=$PPID
while [ -z "$CURRENT_PID" ] && [ -n "$walk_pid" ] && [ "$walk_pid" -gt 1 ]; do
  walk_cmd=$(ps -o comm= -p "$walk_pid" 2>/dev/null | tr -d ' ')
  walk_cmd="${walk_cmd##*/}" # non-login shells can report a full path, e.g. "/bin/zsh"
  walk_cmd="${walk_cmd#-}" # login shells report as "-zsh", "-bash", etc.
  case "$walk_cmd" in
    bash|zsh|sh|fish|dash|tcsh|csh)
      _fallback_pid="$walk_pid"
      if [ -d "$ROOT_DATA_DIR/$walk_pid" ]; then
        CURRENT_PID="$walk_pid"
        break
      fi
      ;;
  esac
  walk_pid=$(ps -o ppid= -p "$walk_pid" 2>/dev/null | tr -d ' ')
done
# Prefer the TMUX_PANE-based pane_pid lookup over the generic walk fallback:
# it's exact (asks tmux which shell actually owns this specific pane),
# whereas _fallback_pid is just "the first shell-named ancestor the walk
# happened to pass through" - which, under `tmux run-shell`, can be the
# throwaway `sh -c` interpreter tmux forks to parse the command string.
# Whether that fork happens is shell-implementation-dependent: observed with
# Debian's dash (a real, separate `sh` process, matching the case below and
# owning no session dir of its own), not on macOS (where that interpreter
# tail-call-execs in place instead of forking, so no spurious shell-named
# ancestor ever appears and this whole block is a no-op there). Without this
# ordering, that throwaway pid would win at the line below and every tmux
# menu action (Acknowledge/Pending/OnHold/...) would silently write state to
# a one-off bogus directory instead of the real session's.
if [ -z "$CURRENT_PID" ] && [ -n "$TMUX_PANE" ]; then
  _pane_pid=$(tmux display-message -t "$TMUX_PANE" -p '#{pane_pid}' 2>/dev/null)
  [ -n "$_pane_pid" ] && [ -d "$ROOT_DATA_DIR/$_pane_pid" ] && CURRENT_PID="$_pane_pid"
fi
[ -z "$CURRENT_PID" ] && CURRENT_PID="$_fallback_pid"

resolve_and_run() {
  local callback="$1"
  if $ALL; then
    for d in "$ROOT_DATA_DIR"/[0-9]*/; do
      [ -f "$d/static.env" ] && $callback "$(basename "$d")"
    done
  else
    if [ "${NOTIFY_REQUIRE_SESSION:-false}" = "true" ] && [ ! -f "$ROOT_DATA_DIR/$CURRENT_PID/static.env" ]; then
      CURRENT_PID=""
    fi
    [ -z "$CURRENT_PID" ] && { echo "No active session found."; exit 1; }
    $callback "$CURRENT_PID"
  fi
}

case "$CMD" in
  user-focus)
    focus_pane="${TMUX_PANE:-}"
    [ -z "$focus_pane" ] && exit 0
    while IFS= read -r line; do
      local_pane_id=$(echo "$line" | awk '{print $1}')
      local_render_pid=$(echo "$line" | awk '{print $2}')
      [ -z "$local_render_pid" ] && continue
      [ -f "$ROOT_DATA_DIR/$local_render_pid/static.env" ] || continue
      if [ "$local_pane_id" = "$focus_pane" ]; then
        update_state_and_render "$local_render_pid" "USER_STATE" "Acknowledged" \
          && log "$local_render_pid" "tmux.focus.Acknowledged pane=$local_pane_id"
      else
        update_state_and_render "$local_render_pid" "USER_STATE" "Seen" \
          && log "$local_render_pid" "tmux.focus.Seen pane=$local_pane_id"
      fi
    done < <(tmux list-panes -F '#{pane_id} #{pane_pid}' 2>/dev/null)
    ;;
  init)
    SYMLINK="$HOME/.local/bin/notify"
    SYMLINK_TARGET="$NOTIFY_RUNTIME_DIR/app/notify"
    [ -f "$SYMLINK_TARGET" ] || SYMLINK_TARGET="$(readlink -f "$0")"
    if [ "$(readlink -f "$SYMLINK" 2>/dev/null)" != "$(readlink -f "$SYMLINK_TARGET")" ]; then
      mkdir -p "$HOME/.local/bin"
      ln -sf "$(readlink -f "$SYMLINK_TARGET")" "$SYMLINK"
    fi
    if command -v tmux >/dev/null 2>&1; then
      HOOKS_CONTENT="$(cat "$NOTIFY_DIR/tmux/tmux-hooks.conf")"
      migrate_managed_block_label "$HOME/.tmux.conf" "CLAUDE-NOTIFY" "AGENT-NOTIFY"
      if deploy_managed_block "$HOME/.tmux.conf" "AGENT-NOTIFY" "$HOOKS_CONTENT"; then
        tmux source-file "$HOME/.tmux.conf" 2>/dev/null
      fi
    fi
    ;;
  status|s)  resolve_and_run cmd_status ;;
  session-start)
    resolve_and_run cmd_refresh
    ;;
  session-end) resolve_and_run cmd_wipe ;;
  event)
    [ -n "$CMD_ARG1" ] || { echo "Usage: notify event <Working|Finished|WaitingForUser|Idle> [--all]"; exit 1; }
    CMD_ARG2="$CMD_ARG1"
    CMD_ARG1="AGENT_STATE"
    resolve_and_run cmd_update_state
    ;;
  wipe)      SAY=true; resolve_and_run user_wipe ;;
  update)    SAY=true; resolve_and_run cmd_update_state ;;
  refresh)   SAY=true; resolve_and_run user_refresh ;;
  *)
    # Anything else is assumed to be a renderer name, e.g. `notify sound-tts enable`.
    SAY=true
    if $GLOBAL; then cmd_settings "_global"
    else resolve_and_run cmd_settings; fi ;;
esac

# --- debounced refresh (runs after every invocation) -----

_last_refresh_file="$ROOT_DATA_DIR/.last_refresh"
_now_epoch=$(date '+%s')
_last_refresh=0
[ -f "$_last_refresh_file" ] && _last_refresh=$(cat "$_last_refresh_file" 2>/dev/null)
# Any session with a suppressed Finished (pending_finish - see
# try_resolve_pending_finish) shortens the debounce so it gets resolved
# within seconds of its subagents actually clearing, instead of waiting up
# to 5 minutes - cheap to check (just file existence) and only changes
# anything while a subagent is genuinely still outstanding somewhere.
_refresh_interval=300
for _d in "$ROOT_DATA_DIR"/[0-9]*/; do
  [ -f "$_d/pending_finish" ] && { _refresh_interval=15; break; }
done
if [ $((_now_epoch - _last_refresh)) -ge $_refresh_interval ]; then
  echo "$_now_epoch" > "$_last_refresh_file"
  # Detached from the hook's stdio so a hook runner waiting for pipe EOF
  # (Codex) does not wait on, or time out over, this background refresh.
  # Keep the original caller/PID snapshot. Starting a fresh CLI here would
  # re-import AGENT_* exported while rendering the last visited session.
  (ALL=true; SAY=false; resolve_and_run cmd_refresh) </dev/null >/dev/null 2>&1 &
fi
