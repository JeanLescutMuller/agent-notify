{
  "name": "notify",
  "version": "4.0.0",
  "description": "Notification system for Claude Code sessions. Visual (pane bg, tab icons), sound (bell, TTS). Configure with: ! notify",
  "author": {
    "name": "Jean Lescut-Muller",
    "email": "jeanlescut@meta.com"
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/notify init", "timeout": 3 }] },
      { "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/notify refresh", "timeout": 2 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/notify update CLAUDE_STATE Working", "timeout": 2 }] }
    ],
    "PreToolUse": [
      { "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/notify update CLAUDE_STATE WaitingForUser", "timeout": 2 }] },
      { "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/notify update CLAUDE_STATE Working", "timeout": 2 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/notify update CLAUDE_STATE Finished", "timeout": 2 }] }
    ],
    "Notification": [
      { "matcher": "idle_prompt",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/notify update CLAUDE_STATE Idle", "timeout": 2 }] },
      { "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/notify update CLAUDE_STATE WaitingForUser", "timeout": 2 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/notify wipe", "timeout": 2 }] }
    ]
  }
}
